{
  "name": "lessonboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/pdf-assets.mjs && node scripts/editor-assets.mjs",
    "prebuild": "node scripts/pdf-assets.mjs && node scripts/editor-assets.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs && node scripts/pwa-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "classroom:build": "tsc --noEmit -p tsconfig.server.json",
    "classroom:start": "node server/index.ts",
    "classroom:prepare": "node server/hosting/prepare.ts",
    "classroom:bootstrap": "node --env-file-if-exists=.env.local server/hosting/bootstrap.ts",
    "classroom": "node --env-file-if-exists=.env.local server/index.ts",
    "classroom:migrate": "node --env-file-if-exists=.env.local server/migrate.ts",
    "classroom:maintain": "node --env-file-if-exists=.env.local server/maintain.ts"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "10.3.0",
    "@tiptap/core": "3.32.2",
    "@tldraw/tlschema": "5.6.0",
    "@tldraw/validate": "5.6.0",
    "@xmldom/xmldom": "0.9.12",
    "dexie": "4.4.7",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.17",
    "fastify": "5.12.8",
    "fflate": "0.8.3",
    "katex": "0.19.1",
    "openid-client": "6.8.9",
    "parse5": "8.1.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svg-pathdata": "9.0.0",
    "tldraw": "5.6.0",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@neondatabase/serverless": "1.2.0",
    "@playwright/test": "1.64.1",
    "@tldraw/assets": "5.6.0",
    "@tldraw/utils": "5.6.0",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
