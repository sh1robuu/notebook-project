# All VITE_ values are visible in the browser. Never put private API credentials here.
# Optional replacement for the public Hobby key in src/config/release.ts.
# Keys must cover the deployed hostname. The SDK verifies them and shows attribution.
VITE_TLDRAW_LICENSE_KEY=

# Optional override for the verified HTTPS production origin in src/config/product.ts.
# Do not use a temporary preview hostname for production indexing.
VITE_SITE_URL=

# For a dedicated classroom frontend build. The existing public build defaults to false.
VITE_CLASSROOM_ENABLED=false

# Fastify only. Use an exact HTTPS origin for hosted classrooms.
CLASSROOM_ORIGIN=http://127.0.0.1:5173
CLASSROOM_BIND_HOST=127.0.0.1
CLASSROOM_PORT=8787
CLASSROOM_SERVE_DIST=false
CLASSROOM_TRUST_PROXIES=
CLASSROOM_DATABASE_URL=
CLASSROOM_MIGRATION_URL=
CLASSROOM_GOOGLE_CLIENT_ID=
CLASSROOM_GOOGLE_CLIENT_SECRET=
CLASSROOM_ROOM_SECRET=
CLASSROOM_ARCHIVED_RETENTION_DAYS=30
