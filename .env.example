# All VITE_ values are visible in the browser. Never put private API credentials here.
# Defaults publish the landing page and an honest unavailable-editor screen.
VITE_EDITOR_RELEASE_ENABLED=false

# Public tldraw SDK license identifier, obtained through the official license process.
# Leave blank until a valid active key covers the actual preview/production hostname.
VITE_TLDRAW_LICENSE_KEY=

# Optional override for the verified HTTPS production origin in src/config/product.ts.
# Do not use a temporary preview hostname for production indexing.
VITE_SITE_URL=
